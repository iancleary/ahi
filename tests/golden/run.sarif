{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "results": [
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "notes.txt"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ],
          "message": {
            "text": "trailing whitespace"
          },
          "ruleId": "ahi/trailing-whitespace"
        },
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "notes.txt"
                },
                "region": {}
              }
            }
          ],
          "message": {
            "text": "file must be empty or end with a single newline"
          },
          "ruleId": "ahi/end-of-file"
        },
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "conflict.txt"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ],
          "message": {
            "text": "merge conflict string `<<<<<<<` found"
          },
          "ruleId": "ahi/merge-conflict"
        },
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "conflict.txt"
                },
                "region": {
                  "startLine": 3
                }
              }
            }
          ],
          "message": {
            "text": "merge conflict string `=======` found"
          },
          "ruleId": "ahi/merge-conflict"
        },
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "conflict.txt"
                },
                "region": {
                  "startLine": 5
                }
              }
            }
          ],
          "message": {
            "text": "merge conflict string `>>>>>>>` found"
          },
          "ruleId": "ahi/merge-conflict"
        },
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "bad.json"
                },
                "region": {}
              }
            }
          ],
          "message": {
            "text": "JSON parse error: EOF while parsing an object at line 2 column 0"
          },
          "ruleId": "ahi/check-json"
        },
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "bad.yml"
                },
                "region": {}
              }
            }
          ],
          "message": {
            "text": "YAML parse error: did not find expected node content at line 2 column 1, while parsing a flow node"
          },
          "ruleId": "ahi/check-yaml"
        },
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "bad.toml"
                },
                "region": {}
              }
            }
          ],
          "message": {
            "text": "TOML parse error: TOML parse error at line 1, column 4\n  |\n1 | a =\n  |    ^\ninvalid string\nexpected `\"`, `'`\n"
          },
          "ruleId": "ahi/check-toml"
        },
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "bidi.txt"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ],
          "message": {
            "text": "bidirectional control U+202E"
          },
          "ruleId": "ahi/trojan-source"
        },
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "key.pem"
                },
                "region": {}
              }
            }
          ],
          "message": {
            "text": "private key found"
          },
          "ruleId": "ahi/private-key"
        },
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/ci.yml"
                },
                "region": {}
              }
            }
          ],
          "message": {
            "text": "action `actions/checkout@v4` must be pinned to a full 40-character commit SHA"
          },
          "ruleId": "ahi/github-actions"
        },
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/ci.yml"
                },
                "region": {}
              }
            }
          ],
          "message": {
            "text": "job `test` is missing permissions"
          },
          "ruleId": "ahi/github-actions"
        },
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Dockerfile"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ],
          "message": {
            "text": "base image `alpine:3.19` is not pinned by a sha256 digest"
          },
          "ruleId": "ahi/dockerfile"
        },
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Dockerfile"
                },
                "region": {
                  "startLine": 2
                }
              }
            }
          ],
          "message": {
            "text": "RUN pipes curl or wget into a shell"
          },
          "ruleId": "ahi/dockerfile"
        },
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Dockerfile"
                },
                "region": {
                  "startLine": 2
                }
              }
            }
          ],
          "message": {
            "text": "download with curl or wget is missing a checksum check in the same RUN (a later layer is not accepted in v0.1)"
          },
          "ruleId": "ahi/dockerfile"
        },
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Dockerfile"
                },
                "region": {}
              }
            }
          ],
          "message": {
            "text": "final stage USER must be present and must not be root"
          },
          "ruleId": "ahi/dockerfile"
        },
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "script.sh"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ],
          "message": {
            "text": "POSIX sh script is missing `set -eu` (pipefail is not required for sh)"
          },
          "ruleId": "ahi/shell-strict"
        },
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".env"
                },
                "region": {}
              }
            }
          ],
          "message": {
            "text": "dotenv file should not be committed (keep secrets out of git; an example file is allowed)"
          },
          "ruleId": "ahi/committed-dotenv"
        }
      ],
      "tool": {
        "driver": {
          "name": "ahi",
          "rules": [
            {
              "fullDescription": {
                "text": "Reports lines with trailing whitespace. A Markdown double-space linebreak is kept when --markdown-linebreak-ext names that extension (or *). The check is report-only unless `ahi run --fix` or a hook argument `--fix` is set, which rewrites the file and fails the hook."
              },
              "id": "ahi/trailing-whitespace",
              "shortDescription": {
                "text": "Trim Trailing Whitespace"
              }
            },
            {
              "fullDescription": {
                "text": "Reports a missing final newline, extra trailing newlines, or a file that is only newlines. Empty files are allowed. The check is report-only unless `ahi run --fix` or a hook argument `--fix` is set, which rewrites the file and fails the hook."
              },
              "id": "ahi/end-of-file",
              "shortDescription": {
                "text": "Fix End of Files"
              }
            },
            {
              "fullDescription": {
                "text": "Reports conflict markers. Unlike upstream check-merge-conflict, ahi scans even when git is not in the middle of a merge."
              },
              "id": "ahi/merge-conflict",
              "shortDescription": {
                "text": "Check for merge conflicts"
              }
            },
            {
              "fullDescription": {
                "text": "Reports files whose size in KiB, rounded up, exceeds --maxkb (default 500). Every selected file is checked, which is upstream's --enforce-all behavior."
              },
              "id": "ahi/large-files",
              "shortDescription": {
                "text": "Check for large files"
              }
            },
            {
              "fullDescription": {
                "text": "Reports paths that differ only by case, including parent directories. That collision breaks a checkout on Windows and on default macOS volumes."
              },
              "id": "ahi/case-conflict",
              "shortDescription": {
                "text": "Check for case conflicts"
              }
            },
            {
              "fullDescription": {
                "text": "Reports a broken symlink, and a symlink whose target escapes the repository root. The escape check is stricter than upstream check-symlinks."
              },
              "id": "ahi/symlinks",
              "shortDescription": {
                "text": "Check for symlinks"
              }
            },
            {
              "fullDescription": {
                "text": "Reports JSON that does not parse, including duplicate object keys."
              },
              "id": "ahi/check-json",
              "shortDescription": {
                "text": "Check JSON"
              }
            },
            {
              "fullDescription": {
                "text": "Reports YAML that does not parse. Aliases are allowed in files under check; they are rejected only in ahi's own config."
              },
              "id": "ahi/check-yaml",
              "shortDescription": {
                "text": "Check YAML"
              }
            },
            {
              "fullDescription": {
                "text": "Reports TOML that does not parse."
              },
              "id": "ahi/check-toml",
              "shortDescription": {
                "text": "Check TOML"
              }
            },
            {
              "fullDescription": {
                "text": "Reports Unicode bidi controls (U+202A–U+202E and U+2066–U+2069) and a documented set of Latin/Cyrillic/Greek homoglyphs on the same line. This is not the full Unicode confusables database."
              },
              "id": "ahi/trojan-source",
              "shortDescription": {
                "text": "Trojan Source"
              }
            },
            {
              "fullDescription": {
                "text": "Reports path components Windows rejects: device names (CON, PRN, AUX, NUL, COM1–COM9, LPT1–LPT9, including superscripts), trailing dots or spaces, and characters <>:\"|?*."
              },
              "id": "ahi/windows-reserved-names",
              "shortDescription": {
                "text": "Check Windows reserved names"
              }
            },
            {
              "fullDescription": {
                "text": "Reports private-key headers. The marker list is the one in pre-commit-hooks detect_private_key.py as of 2026-10-25. This is not a general entropy scanner."
              },
              "id": "ahi/private-key",
              "shortDescription": {
                "text": "Detect private key"
              }
            },
            {
              "fullDescription": {
                "text": "Reports CR, LF, and CRLF mixed in one file. The check is report-only, like upstream --fix=no, unless `ahi run --fix` or a hook argument `--fix` (auto, lf, crlf, or cr) is set. --fix=no stays report-only."
              },
              "id": "ahi/line-endings",
              "shortDescription": {
                "text": "Mixed Line Endings"
              }
            },
            {
              "fullDescription": {
                "text": "An executable text file must start with #!. Tracked files use the git index mode so Windows and WSL agree. Upstream check-executables-have-shebangs."
              },
              "id": "ahi/shebang-executable",
              "shortDescription": {
                "text": "Check Executables Have Shebangs"
              }
            },
            {
              "fullDescription": {
                "text": "A tracked text file that starts with #! must be executable in the git index. Untracked files are skipped, matching upstream check-shebang-scripts-are-executable."
              },
              "id": "ahi/executable-shebang",
              "shortDescription": {
                "text": "Check Shebang Scripts Are Executable"
              }
            },
            {
              "fullDescription": {
                "text": "Fails when the current branch is one of --branch (default main and master) or matches --pattern from the start of the name. A detached HEAD passes. This matches upstream no-commit-to-branch."
              },
              "id": "ahi/no-commit-to-branch",
              "shortDescription": {
                "text": "Don't Commit to Branch"
              }
            },
            {
              "fullDescription": {
                "text": "Reports XML that is not well-formed. External entities are not resolved and no network request is made. Upstream check-xml."
              },
              "id": "ahi/check-xml",
              "shortDescription": {
                "text": "Check Xml"
              }
            },
            {
              "fullDescription": {
                "text": "Reports AWS access key ids (AKIA, ASIA, ABIA, ACCA plus 16 uppercase letters or digits) and 40-character secret, session, or security tokens assigned on the same line. Does not read ~/.aws, credential files, or the environment. Upstream detect-aws-credentials instead searches for secrets it loaded from those files; ahi cannot do that inside a sandbox without a home directory."
              },
              "id": "ahi/aws-credentials",
              "shortDescription": {
                "text": "Detect Aws Credentials"
              }
            },
            {
              "fullDescription": {
                "text": "Reports GitHub blob links whose revision is not a 4 to 64 digit hex commit and that point at a line number. A 40-hex permalink is allowed. --additional-github-domain adds a host. Upstream check-vcs-permalinks."
              },
              "id": "ahi/vcs-permalinks",
              "shortDescription": {
                "text": "Check Vcs Permalinks"
              }
            },
            {
              "fullDescription": {
                "text": "Reports a leading UTF-8 BOM (EF BB BF). The check is report-only. `ahi run --fix` does not strip the marker."
              },
              "id": "ahi/byte-order-marker",
              "shortDescription": {
                "text": "Fix Utf-8 Byte Order Marker"
              }
            },
            {
              "fullDescription": {
                "text": "Requires actions and reusable workflows to be pinned to a full commit SHA (or an image digest), requires an explicit permissions block of read or none, and flags pull_request_target checkouts of the PR head or use of secrets in run steps. --allow-write=contents permits that one write permission."
              },
              "id": "ahi/github-actions",
              "shortDescription": {
                "text": "GitHub Actions pinning"
              }
            },
            {
              "fullDescription": {
                "text": "Requires every FROM image except scratch to be pinned by sha256 digest, a non-root USER in the final stage, no curl|sh or wget|sh, a checksum next to curl/wget downloads, and version-pinned apt packages."
              },
              "id": "ahi/dockerfile",
              "shortDescription": {
                "text": "Dockerfile supply chain"
              }
            },
            {
              "fullDescription": {
                "text": "Bash and zsh scripts must set -euo pipefail (or the three options separately). POSIX sh must set -eu; pipefail is not required because it is not POSIX."
              },
              "id": "ahi/shell-strict",
              "shortDescription": {
                "text": "Shell strict mode"
              }
            },
            {
              "fullDescription": {
                "text": "Reports a file named .env or .env.* other than .env.example, .env.sample, and .env.template. Files such as versions/tool.env are not dotenv files and are not flagged."
              },
              "id": "ahi/committed-dotenv",
              "shortDescription": {
                "text": "Committed dotenv file"
              }
            }
          ],
          "version": "0.1.1"
        }
      }
    }
  ],
  "version": "2.1.0"
}
